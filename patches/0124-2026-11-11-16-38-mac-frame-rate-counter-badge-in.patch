 dm/host/front_mac.m                      | 22 ++++++++++++++++++++++
 dm/tools/tests/test_launcher_settings.py |  5 +++--
 docs/settings.md                         |  4 ++--
 4 files changed, 28 insertions(+), 5 deletions(-)

