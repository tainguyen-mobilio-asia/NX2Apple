diff --git a/dm/host/front_mac.m b/dm/host/front_mac.m
index b407953..6df8af4 100644
--- a/dm/host/front_mac.m
+++ b/dm/host/front_mac.m
@@ -507,6 +507,27 @@ - (void)windowDidFailToEnterFullScreen:(NSWindow *)w { (void)w; if (g_fs_failed)
     ((guest_arg *)p)->fn(); LOG("guest thread finished"); exit(0);
 }
 
+// Frame-rate counter (DM_SHOW_FPS=1, the launch settings' Frame-rate counter): a small badge at the top left of the game's picture, as the iPhone's (front_ios.m): the frames put
+// on screen in the last second (nvn_mtl.m counts them for NVN and for the Vulkan layer alike; frames the display link merged away are not counted)
+uint64_t mtl_present_count(void);
+static void fps_badge(NSView *cv) {
+    NSTextField *l = [NSTextField labelWithString:@"-- fps"];
+    l.font = [NSFont monospacedDigitSystemFontOfSize:13 weight:NSFontWeightSemibold]; l.textColor = NSColor.whiteColor; l.alignment = NSTextAlignmentCenter;
+    NSView *box = [[NSView alloc] initWithFrame:NSMakeRect(12, cv.bounds.size.height - 12 - 22, 64, 22)];
+    box.autoresizingMask = NSViewMaxXMargin | NSViewMinYMargin;   // stays at the top left when the window is resized or goes fullscreen
+    box.wantsLayer = YES; box.layer.backgroundColor = [NSColor colorWithWhite:0 alpha:0.45].CGColor; box.layer.cornerRadius = 6;
+    l.frame = NSMakeRect(0, floor((22 - l.intrinsicContentSize.height) / 2), 64, l.intrinsicContentSize.height);
+    [box addSubview:l]; [cv addSubview:box];
+    __block uint64_t n0 = mtl_present_count(); __block double t0 = CACurrentMediaTime();
+    NSTimer *t = [NSTimer timerWithTimeInterval:1.0 repeats:YES block:^(NSTimer *tm) {
+        (void)tm; uint64_t n = mtl_present_count(); double now = CACurrentMediaTime();
+        if (now - t0 < 1.5) l.stringValue = [NSString stringWithFormat:@"%.0f fps", (n - n0) / (now - t0)];   // a longer span is a stalled main thread: no reading
+        n0 = n; t0 = now;
+    }];
+    [NSRunLoop.mainRunLoop addTimer:t forMode:NSRunLoopCommonModes];   // common modes: it keeps counting while a menu is open or the window is resized
+    LOG("front end: frame-rate counter on (DM_SHOW_FPS)");
+}
+
 // Metal reads MTL_HUD_ENABLED when the process makes its first device, which can be before the window: set from DM_METAL_HUD before main (set in front_run, the HUD did not show)
 __attribute__((constructor)) static void hud_env(void) { front_hud_env(); }
 
@@ -1401,6 +1422,7 @@ void front_run(void (*guest)(void)) {
         [win makeKeyAndOrderFront:nil];
         screen_refresh(win.screen ?: NSScreen.mainScreen);
         g_win = win;
+        if (getenv("DM_SHOW_FPS") && atoi(getenv("DM_SHOW_FPS"))) fps_badge(win.contentView);
         // Activated once the run loop below runs, not here: an app that takes the front while its main thread is still busy with the setup below can show
         // the pointer for a frame although it hid it (DM_CURSOR_HIDDEN, issue #380)
         dispatch_async(dispatch_get_main_queue(), ^{ [NSApp activateIgnoringOtherApps:YES]; });
